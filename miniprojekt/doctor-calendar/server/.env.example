PORT=3333
# The calendar uses local browser time; browser and clinic zones must match for edits.
SCHEDULE_TIME_ZONE=Europe/Warsaw
# Realtime Database URL (from the Firebase console)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.region.firebasedatabase.app
# Choose one of the following credential options:
# 1) Absolute path to a local service account JSON file (keep it outside this repository)
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccount.json
# 2) Or supply the JSON on a single line (do not configure both options)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Comma-separated administrator email addresses (used when creating profiles)
ADMIN_EMAILS=admin@example.com
# Exact frontend origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
